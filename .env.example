# LaunchDarkly — API key for bootstrap (creates the project, graph, configs, flag)
LD_API_KEY=api-xxxxx

# LaunchDarkly — the project and its server SDK key (used by the runners +
# harness). The SDK key is the project's production environment key.
LD_PROJECT_KEY=graph-experiments
LD_SDK_KEY=sdk-xxxxx

# Model Provider API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxx    # Experiment A: the pinned model (Claude) across all nodes
OPENAI_API_KEY=sk-xxxxx           # Experiment B: OpenAI Agents native bake-off
GOOGLE_API_KEY=xxxxx              # Experiment B: Google ADK / Gemini native bake-off

# AWS (optional — for Strands via Bedrock)
AWS_PROFILE=your-profile
AWS_REGION=us-east-1

# Optional
DEBUG=false
LANGGRAPH_RECURSION_LIMIT=30
