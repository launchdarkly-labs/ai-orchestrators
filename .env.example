# LaunchDarkly — API key for bootstrap + native-routing setup (creates the graph, configs,
# flag, judge, and model variations). Personal/service token with write access.
LD_API_KEY=api-xxxxx

# LaunchDarkly — the project and its server SDK key (used by the runners + harness).
# LD_SDK_KEY is the project's PRODUCTION environment SDK key; if it's rotated in the UI,
# update it here or the SDK returns 401 (invalid SDK key) and no metrics record. Read the
# current one with:
#   GET /api/v2/projects/$LD_PROJECT_KEY/environments/production  -> .apiKey
LD_PROJECT_KEY=graph-experiments
LD_SDK_KEY=sdk-xxxxx

# --- Model provider credentials -------------------------------------------------------------
# Experiment A pins Claude across all nodes, so ANTHROPIC_API_KEY is the only required one.
# Experiment B (native bake-off) routes each orchestrator to its provider's flagship, so it
# needs the matching credential per framework below. Each must be a paid/credited account —
# free tiers 401 or 429 (e.g. Gemini free tier = 0 quota for pro models; OpenAI needs credits).
ANTHROPIC_API_KEY=sk-ant-xxxxx    # langgraph (direct Claude) + Experiment A pinned model
OPENAI_API_KEY=sk-xxxxx           # openai-agents (GPT) — requires billing/credits
GOOGLE_API_KEY=xxxxx              # google-adk (Gemini) — pro models require a billing-enabled project

# AWS — for strands via Bedrock. Refresh SSO with: source scripts/aws/login.sh (reads AWS_PROFILE).
# The strands runner defaults to us-west-2 and prepends the cross-region inference-profile prefix.
AWS_PROFILE=your-sso-profile
AWS_REGION=us-west-2

# Optional
DEBUG=false
LANGGRAPH_RECURSION_LIMIT=30
